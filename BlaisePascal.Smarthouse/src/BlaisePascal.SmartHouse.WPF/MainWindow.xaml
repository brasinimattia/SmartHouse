<Window x:Class="BlaisePascal.SmartHouse.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Smart Home Manager" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Background="Black" Foreground="White" UniformCornerRadius="0">
            <StackPanel Margin="0,20,0,0">

                <TextBlock Text="Smart Home" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Margin="20,10,20,30" 
                           Foreground="#2196F3"/>

                <Button Content="Lamps" 
                        Click="NavLamps_Click" 
                        Style="{StaticResource MaterialDesignFlatLightBgButton}" 
                        Height="50" 
                        HorizontalContentAlignment="Left" 
                        Background="#2196F3"
                        BorderBrush="Black"
                        Padding="20,0"/>

                <Button Content="CCTV" 
                        Click="NavCctv_Click" 
                        Style="{StaticResource MaterialDesignFlatLightBgButton}" 
                        Height="50" 
                        HorizontalContentAlignment="Left" 
                        Background="#2196F3"
                        BorderBrush="Black"
                        Padding="20,0"/>

                <Button Content="Doors" 
                        Click="NavDoors_Click" 
                        Style="{StaticResource MaterialDesignFlatLightBgButton}" 
                        Height="50" 
                        HorizontalContentAlignment="Left" 
                        Padding="20,0"
                        Background="#2196F3"
                        BorderBrush="Black"
                       />

            </StackPanel>
        </materialDesign:Card>

        <ContentControl x:Name="MainContentArea"
                    Grid.Column="1"/>
    </Grid>
</Window>

